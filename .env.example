# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave secreta: solo en el servidor (Vercel). Nunca la publiques.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominio interno para las cuentas de alumnas (no recibe mails; solo identifica el usuario)
STUDENT_EMAIL_DOMAIN=alumnas.legday.com.ar

# --- WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=es_AR
# Si está en "true", no envía nada y solo registra los mensajes (útil para probar)
WHATSAPP_DRY_RUN=false

# --- Tarea diaria de recordatorios (Vercel la manda en el header Authorization) ---
CRON_SECRET=una-clave-larga-y-aleatoria

# URL pública, usada en los mensajes
NEXT_PUBLIC_SITE_URL=https://legday.com.ar
